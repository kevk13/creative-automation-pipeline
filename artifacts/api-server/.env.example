# ─────────────────────────────────────────────────────────────────────────────
# Creative Automation Pipeline — local environment configuration
# Copy this file to .env and fill in your API keys.
#   cp artifacts/api-server/.env.example artifacts/api-server/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── AI API Keys (required for local runs) ─────────────────────────────────────
# Anthropic — used for prompt crafting (claude-sonnet-4-5) and logo vision checks
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI — used for image generation (gpt-image-1 / DALL-E 3 compatible)
OPENAI_API_KEY=sk-proj-...

# ── Server ────────────────────────────────────────────────────────────────────
# Port the Express server listens on. Override if 5000 is already taken.
PORT=5000

# ─────────────────────────────────────────────────────────────────────────────
# REPLIT ONLY — set automatically by Replit AI Integrations, do not set manually
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://...
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=...
# AI_INTEGRATIONS_OPENAI_BASE_URL=https://...
# AI_INTEGRATIONS_OPENAI_API_KEY=...
# ─────────────────────────────────────────────────────────────────────────────
