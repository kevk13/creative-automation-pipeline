# Creative Automation Pipeline - API server environment configuration
# Copy this file to .env and fill in your API keys.
#   cp artifacts/api-server/.env.example artifacts/api-server/.env

# ── Required: AI API keys ─────────────────────────────────────────────────────

# Anthropic - used for prompt crafting (claude-sonnet-4-5) and logo vision checks
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini - used for image generation (gemini-2.5-flash-image)
# On Replit this is provided automatically via AI Integrations - no action needed
GEMINI_API_KEY=AIza...

# ── Required: server port ─────────────────────────────────────────────────────

PORT=4000

# ── Optional: storage backend ─────────────────────────────────────────────────
# Defaults to "local" - no extra config needed.
# Set to "dropbox" and provide a token to upload outputs to Dropbox.

STORAGE_ADAPTER=local

# STORAGE_ADAPTER=dropbox
# DROPBOX_ACCESS_TOKEN=your_token_here

# ── Replit only - set automatically by AI Integrations, do not set manually ───
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://...
# AI_INTEGRATIONS_ANTHROPIC_API_KEY=...
# AI_INTEGRATIONS_GEMINI_BASE_URL=https://...
# AI_INTEGRATIONS_GEMINI_API_KEY=...
