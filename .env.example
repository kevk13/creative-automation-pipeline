# Creative Automation Pipeline - environment configuration
# Copy to .env and fill in your values:
#   cp .env.example .env

# ── Required: AI API keys ─────────────────────────────────────────────────────

# Anthropic - used for prompt crafting (claude-sonnet-4-5) and compliance vision checks
ANTHROPIC_API_KEY=sk-ant-api03-...

# Google Gemini - used for image generation (gemini-2.5-flash-image)
# On Replit this is provided automatically via AI Integrations - no action needed
GEMINI_API_KEY=AIza...

# ── Required: server port ─────────────────────────────────────────────────────

PORT=5000

# ── Optional: storage backend ─────────────────────────────────────────────────
# Defaults to "local" - generated images saved to output/ on disk, no extra config.
# Set to "dropbox" to upload outputs to Dropbox and return shared download links.

STORAGE_ADAPTER=local

# STORAGE_ADAPTER=dropbox
# DROPBOX_ACCESS_TOKEN=your_token_here
# Generate a token at https://www.dropbox.com/developers/apps
# Required app permissions: files.content.write, files.content.read,
#                           sharing.write, sharing.read
