# ── Storage adapter selection ────────────────────────────────────────────────
# Supported values: local (default), dropbox
# local   — write to ./output/ on the API server filesystem (no extra config)
# dropbox — upload to Dropbox and return shared links (requires token below)
STORAGE_ADAPTER=local

# ── Dropbox cloud storage ─────────────────────────────────────────────────────
# Uncomment both lines to route pipeline outputs to Dropbox.
# Generate an access token at https://www.dropbox.com/developers/apps
#   App permissions required: files.content.write, files.content.read,
#   sharing.write, sharing.read
# STORAGE_ADAPTER=dropbox
# DROPBOX_ACCESS_TOKEN=your_token_here

# ── AI integrations ───────────────────────────────────────────────────────────
# Populated automatically by the Replit AI Integrations panel.
# Do NOT commit real values — use Replit Secrets instead.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
